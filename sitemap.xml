---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url | xml_escape }}</loc>
  </url>
  {% for tab in site.tabs %}
    {% unless tab.sitemap == false %}
    <url>
      <loc>{{ tab.url | absolute_url | xml_escape }}</loc>
    </url>
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
    {% unless post.sitemap == false %}
    {% assign modified = post.lastmod | default: post.last_modified_at | default: post.date %}
    <url>
      <loc>{{ post.url | absolute_url | xml_escape }}</loc>
      <lastmod>{{ modified | date_to_xmlschema }}</lastmod>
    </url>
    {% endunless %}
  {% endfor %}
</urlset>
